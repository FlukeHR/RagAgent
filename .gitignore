# Local environment and credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Python caches, environments, and test output
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.venv/
venv/

# Editor and local agent state
.idea/
.vscode/
*.code-workspace
/.agents/
/.codex/

# Application runtime data. Keep only the Python package marker in Git.
/data/*
!/data/__init__.py

# Reproducible local model downloads
/models/

# Frontend dependencies, caches, test output, and production build
/frontend/web/node_modules/
/frontend/web/.npm-cache/
/frontend/web/.vite/
/frontend/web/coverage/
/frontend/web/dist/

# Logs and interrupted temporary files
*.log
*.tmp
*.temp
*.part
*.bak

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
